#!/bin/sh
# 커밋 전 비밀값 검사.
# 1) gitleaks: 알려진 형식의 비밀값
# 2) 이 컴퓨터에 있는 실제 키·비밀값과 같은 값이 스테이징된 변경에 있으면 막는다.
#    (gitleaks는 이름 없이 값만 있는 키를 놓칠 수 있다. 값은 출력하지 않는다.)

gitleaks git --pre-commit --staged --redact --verbose || exit 1

secrets=$(mktemp)
trap 'rm -f "$secrets"' EXIT

# 통째로 키인 파일 (NOF_SECRET_FILES: 콜론으로 구분한 추가 파일, 확인용)
for f in "$HOME/.config/typesafe/api_key" $(printf '%s' "${NOF_SECRET_FILES:-}" | tr ':' ' '); do
  [ -r "$f" ] && { cat "$f"; echo; } >> "$secrets"
done

# KEY=VALUE 형식 파일의 값 (주소는 문서에도 쓰이므로 제외)
for f in supabase/.env .env.local .env.cloud; do
  [ -r "$f" ] && sed -n 's/^[A-Za-z_][A-Za-z0-9_]*=//p' "$f" | tr -d "\"'" | grep -v '^https\{0,1\}://' >> "$secrets"
done

# 짧은 값은 오탐을 줄이려고 제외
long=$(awk 'length($0) >= 16' "$secrets")
[ -z "$long" ] && exit 0

if git diff --cached --no-color -U0 | grep '^+' | grep -qF "$long"; then
  echo "커밋 중단: 이 컴퓨터의 키·비밀값과 같은 값이 스테이징된 변경에 들어 있습니다." >&2
  echo "해당 줄을 지우고 다시 스테이징하세요." >&2
  exit 1
fi
