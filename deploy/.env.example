# NAS 프로젝트 폴더의 .env 견본. 실제 값은 NAS에만 두고(권한 600) 커밋하지 않는다.
# 컨테이너 묶음 이름(compose 1.x·2.x 모두 이 값을 쓴다)
COMPOSE_PROJECT_NAME=nof-ledger
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
TYPESAFE_API_KEY=
# Google 로그인을 우리 화면에서 직접 받을 때의 OAuth 클라이언트 ID(공개 값). 비우면 리디렉트 방식
GOOGLE_CLIENT_ID=
TUNNEL_TOKEN=
# Supabase Session pooler 주소(IPv4). 비밀번호 포함.
BACKUP_DATABASE_URL=
