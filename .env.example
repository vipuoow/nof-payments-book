# Supabase (서버 전용 키에는 NEXT_PUBLIC_을 붙이지 않는다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 초대 링크 등에 쓰는 앱 주소
APP_URL=http://127.0.0.1:3100
# TypeSafe(jev) 카테고리 자동 분류. 비워 두면 분류하지 않는다(서버 전용)
TYPESAFE_API_KEY=
# Google 로그인을 우리 화면에서 직접 받을 때의 OAuth 클라이언트 ID(공개 값). 비우면 리디렉트 방식
GOOGLE_CLIENT_ID=
